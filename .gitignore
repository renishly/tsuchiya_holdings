# Only the agent folder is tracked. Prompt files, syllabus, plan and secrets stay local
# unless the student adds them deliberately.
/*
!/.gitignore
!/v1/
!/v2/
!/.github/
# never commit secrets or scratch
project secrets/
secrets/
.env
*.key
**/sa.json
**/*service-account*.json
v1/tmp/
v1/state/run.lock
.DS_Store
v1/prompt.md
v1/prompt.org
v1/.claude/settings.local.json
v1/.dashboard.env
.env
v1/HOW_THE_AGENT_WORKS.html
v1/AGENT_RUNDOWN.html
v2/app/tmp/
v2/app/state/run.lock
v2/app/.dashboard.env
v2/**/__pycache__/
v2/app/prompt2.org
v2/resources/
